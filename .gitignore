# Keep the repository code-only by default.
# Directories stay visible so source files can be allow-listed recursively.
*
!*/

# Repository metadata and documentation.
!.gitignore
!README.md
!**/README.md
!LICENSE
!LICENSE.*
!**/LICENSE
!**/LICENSE.*

# Python and shell code.
!*.py
!*.pyi
!*.sh

# Native/CUDA source needed by imported detection frameworks.
!*.c
!*.cc
!*.cpp
!*.h
!*.hpp
!*.cu
!*.cuh

# Reproducible experiment and build configuration.
!*.yaml
!*.yml
!*.toml
!*.cfg
!*.ini
!*.cmake
!CMakeLists.txt
!Makefile
!requirements*.txt

# Never track caches or compiled artifacts.
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/*.py[cod]
**/*.so
**/*.o
**/*.a

# Never track datasets, temporary files, checkpoints, or experiment outputs.
**/data/
**/tmp/
**/temp/
**/cache/
**/caches/
**/ckpt/
**/checkpoints/
**/output/
**/outputs/
**/work_dirs/
**/router_work_dirs/
**/runs/
**/logs/
**/results/
**/result/
experiment_results/

# Common generated artifacts outside the standard output directories.
*.log
*.csv
*.json
*.npy
*.npz
*.bin
*.pkl
*.pth
*.pt
*.ply
*.pcd
*.png
*.jpg
*.jpeg
*.pdf
*.zip
*.tar
*.gz
*.7z
